exact crates/loom-widget-embed-island-checkout-form/build.rs
exact crates/loom-widget-embed-island-mini-dashboard/build.rs
exact crates/loom-widget-embed-island-product-card/build.rs
exact crates/loom-widget-embed-island-quantity-picker/build.rs
